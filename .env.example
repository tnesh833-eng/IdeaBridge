# GEMINI_API_KEY: Required for SIH Unique Ideas generation (and Stage 2 AI Agents).
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# SESSION_SECRET: Server-side secret for signing authentication tokens (optional in local preview; auto-generated in memory if omitted).
SESSION_SECRET=

# ADMIN_EMAILS: Optional comma-separated list of emails granted admin access on sign-up/login.
ADMIN_EMAILS=

# ADMIN_PASSCODE: Optional server-side passcode to unlock Admin SIH spreadsheet import.
ADMIN_PASSCODE=

# SUPABASE: Optional Supabase project configuration for Google OAuth and PostgreSQL storage.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# GOOGLE MAPS: Scoped public browser key for College Profile maps.
VITE_GOOGLE_MAPS_API_KEY=

# MONGODB: MongoDB Atlas connection string for Express RESTful APIs and serverless/load-balanced persistence.
MONGODB_URI=

# CLUSTER_WORKERS: Optional worker process count when running npm run start:cluster (defaults to CPU count up to 4).
CLUSTER_WORKERS=

# INSTANCE_ID: Optional node/replica identifier reported by /api/health and /healthz.
INSTANCE_ID=

