{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public student profile record visible on IdeaBridge without PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "college": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "bio": {
          "type": "string",
          "maxLength": 300
        },
        "skills": {
          "type": "array",
          "description": "Up to 15 technical skills."
        },
        "pointsBalance": {
          "type": "number"
        },
        "ideasPosted": {
          "type": "number"
        },
        "projectsBuilt": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "name", "college", "pointsBalance", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Owner-only PII document holding student email and notification preferences.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 5,
          "maxLength": 120
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "updatedAt"]
    },
    "IdeaSummary": {
      "title": "IdeaSummary",
      "description": "Project idea card synchronized with IdeaBridge.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 4,
          "maxLength": 120
        },
        "summary": {
          "type": "string",
          "minLength": 15,
          "maxLength": 240
        },
        "domain": {
          "type": "string",
          "enum": ["Environment", "Health", "Education", "FinTech", "Campus Tech", "Civic"]
        },
        "difficulty": {
          "type": "string",
          "enum": ["Beginner", "Intermediate", "Advanced"]
        },
        "status": {
          "type": "string",
          "enum": ["open", "archived"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "authorUid", "title", "summary", "domain", "difficulty", "status", "createdAt", "updatedAt"]
    },
    "PointLedgerEntry": {
      "title": "PointLedgerEntry",
      "description": "Immutable points audit record owned by a user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "type": {
          "type": "string",
          "enum": ["earn_post", "earn_unlock", "bonus"]
        },
        "amount": {
          "type": "number"
        },
        "reason": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "userUid", "type", "amount", "reason", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Public student profile document without PII."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Private PII subcollection strictly restricted to the profile owner."
    },
    "/ideas/{ideaId}": {
      "schema": { "$ref": "#/entities/IdeaSummary" },
      "description": "Idea cards created and managed by verified student authors."
    },
    "/points/{txId}": {
      "schema": { "$ref": "#/entities/PointLedgerEntry" },
      "description": "Owner-readable points ledger entries."
    }
  }
}
